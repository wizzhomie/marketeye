# Copy to .env and fill in values. .env is gitignored; never commit real keys.
#
# Optional AI buyer note (free Groq tier):
#   https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional Telegram delivery of the daily digest (free, plain bot API):
#   1. talk to @BotFather, /newbot, copy the token
#   2. put the token here, press Start in your new bot
#   3. run: .venv/bin/python -c "import telegram; print(telegram.discover_chat_id())"
#      and put the returned chat id here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
